# ****************************************************************************
#	Name    : Default.EDF
#	Author  : J. Alamparambil
#	Version : 1.0,Oct 3,2000
#	Copyright (C) 2000 Check Six Studios
#
#	These coded instructions, statements and computer programs contain
#	unpublished information proprietary to Check Six Studios and are protected 
#	by Canadian and US federal copyright laws. They may not be disclosed to third 
#	parties or copied or duplicated, in whole or in part, without prior written
#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	Description of all attributes of a Spyro character
# ****************************************************************************

# The type of character this file defines
Type:					Dragon					

#	MRB File
Geometry_File:			"DRAGON.MRB"

#	Animation State File
#Animation_State_Index:	0
AGRFile: "DRAGON.AGR"

# Movement parameters in M/s
MaxForward:				10.0			
ForwardAccel:			10.0	
# Turning parameters in Deg/Sec	
MaxTurn:				200.0				


#  new way of doing clip effects.  YOU WILL NEED CODE DATED 2/1/02 or later for this to work!
#  First define Clips as follows.
#
#  ClipEffectDef:  index_(used_later)    "name_of_clip_effect.mrb"   node_to_attach_to   sound
#
#   the indexes don't have to be sequential, but they should be between 0 and 19.  If you need more than
#          20, let me know, and I'll up the maximum.
#   the node to attach to can be  none  or  root  or  a specific node name.  IF AND ONLY IF you use a specific
#   node name you should put it in quotes, and make sure the case is the same as in Maya.

ClipEffectDef:	0   "super_smash_land.mrb"  NONE  0
ClipEffectDef:	1   "Jump_start_dust.mrb"   ROOT  0
ClipEffectDef:	2   "dust_stop.mrb"   	    ROOT  0
ClipEffectDef:	4   "charge_dust.mrb"       ROOT  0  
ClipEffectDef:	5   "swimming_bubbles.mrb" "head" 0  
ClipEffectDef:  6   "ouch_stars.mrb"        ROOT  0
ClipEffectDef:  7   "smackwall.mrb"         NONE  0
ClipEffectDef:  8   "smoke_rings.mrb"      "head" 0
ClipEffectDef:  9   "S_Smoke.mrb"          "head" 0 
#ClipEffectDef:  10   "Super_Charge.mrb"          "hip" 0 

#  Once all your clip effects are defined, specify how to use them
#
#   ClipEffect:   "name_of_animation_to_trigger_the_effect"
#					{
#                   index(from_the_definition_above)     delay     surface_indicator
#      ---> you can have more than one line for different surfaces.
#				    }
#
#   surface_indicator can be  GROUND,  WATER,  LAVA,  or  ALL
#


ClipEffect:    "spyro_supersmash_end"  
				{
				0          0.0     ALL
				}  	

ClipEffect:   "spyro_jump_land" 
				{
				1     0.0      ALL 
				}

ClipEffect:    "spyro_stop_run"  
				{
				2     0.0    ALL
				}

ClipEffect:   "spyro_damage" 
			 	{
				6 	0.0  ALL
				}

#ClipEffect:    "spyro_smackwall"   	
#				{
#				6   	0.0  ALL
#				}


#ClipEffect:   "spyro_jump_start" 
#ClipEffect:    "spyro_charge"   	"dust_stop.mrb"   	0.0  "root"  0
#ClipEffect:   "spyro_defeated"   	"ouch_stars.mrb"   	0.1   "none"  0
#ClipEffect:    "spyro_swim"	   	"water_splash.mrb"   	0.0   "none"  0
				


ClipEffectAGR:  101
				{
				4     0.0   ALL
				}
							
ClipEffectAGR:   104 		{ 	
				5    0.0   ALL
				}

ClipEffectAGR:   105   		{ 	
				5  0.2  ALL
				}

ClipEffectAGR:	 106	 	{ 	
				5  0.0  ALL
				}

ClipEffectAGR:  100  		{
				7  0.0  ALL
				}

ClipEffectAGR:   103		{
			 	8   	0.3  ALL
			 	} 

ClipEffectAGR:   102   		{
				9   	0.2  ALL
				}

#ClipEffectAGR:   107   		{
#				10   	0.0  ALL
#				}


# Animation tweaks...  "AnimTweak:   clipName  animSpeed"
# currently must match the order of the clips in the .agr file (clipName is for reference only)
# THIS SHOULD ALWAYS CONTAIN EVERY SPYRO ANIMATION WHETHER IT IS LOADED OR NOT!
AnimTweak:	moveIdle    1.0 
