# The type of character this file defines (it's not used really)
Type:			Zoe					

#	MRB File
Geometry_File:		"fairy.mrb"

#	Animation State File
#Animation_State_Index:	0
AGRFile: "ZOE.AGR"

Mech {
	DetectionDist:    15.0
	ActivationDist:   7.0
	Laser
