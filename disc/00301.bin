# ****************************************************************************
#	Name    : Container.EDF
#	Author  : T.Yap
#	Version : 1.0,Oct ,2001
#	Copyright (C) 2000 Check Six Studios
#
#	These coded instructions, statements and computer programs contain
#	unpublished information proprietary to Check Six Studios and are protected 
#	by Canadian and US federal copyright laws. They may not be disclosed to third 
#	parties or copied or duplicated, in whole or in part, without prior written
#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	Description of all attributes of a Spyro character
# ****************************************************************************

# The type of character this file defines
Type:					Container					

#	MRB File
Geometry_File:			"underwater_vase.MRB"

#	Ways to destroy container
Destruction_Mask
{
	All
}
Shrapnel_File:	"UNDERWATER_VASE_SHRAP.edf"

#	Treasure list
#Treasure:	"gem1.edf"
Treasure:	"gem2.edf"
#Treasure:	"gem5.edf"
#Treasure:	"gem10.edf"
#Treasure:	"gem25.edf"

Collision
{
	Primitive: Box
	ID: 256
}

SoundFX
{
	OnDie: 502
}
#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected
Shadow_Name:		"Shadow_s.mrb"

#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"underwater_vase_Shrap_A.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		600	900
	VertRange:		50	75
	LifeRange:		2	3
	Bounce:			0.75
	Rotate_Axis_X:		10	15			
	Rotate_Axis_Y:		10	15			
	Rotate_Axis_Z:		10	15			
	Gravity:		600.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
}

IndvShrapDef
{
	ShrapnelGraph:		"underwater_vase_Shrap_B.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		600	900
	VertRange:		50	75
	LifeRange:		2	3
	Bounce:			0.65
	Rotate_Axis_X:		10	15			
	Rotate_Axis_Y:		10	15			
	Rotate_Axis_Z:		10	15			
	Gravity:		600.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
}

IndvShrapDef
{
	ShrapnelGraph:		"underwater_vase_Shrap_C.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		600	900
	VertRange:		50	75
	LifeRange:		2	3
	Bounce:			0.7
	Rotate_Axis_X:		10	15			
	Rotate_Axis_Y:		10	15			
	Rotate_Axis_Z:		10	15			
	Gravity:		500.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
}


#	STATE DEFINITIONS
#	These define the state of the shrapnel
#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	SoundFX	502	}
	{ DEFSTATE_IDLE			}
	{ DEFSTATE_BOUNCE	}
	{ DEFSTATE_ONDIE	}
}
