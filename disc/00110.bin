STATE_DEFINITION
{
	# Movement

	idle        	{ FILE_NAME "bln_idle" PRECACHE INTERRUPTIBLE CYCLING}
	fly	   	{ FILE_NAME "bln_flight" INTERRUPTIBLE CYCLING}
	die	 	{ FILE_NAME "bln_popaway" INTERRUPTIBLE 
				CALLBACK
			 	{
		 		FRAME 0.1 1.0
		 		SOUND 600
			 	}
			}
	take_damage 	{ FILE_NAME "bln_damage" INTERRUPTIBLE }
	smoking	 	{ FILE_NAME "bln_caution" INTERRUPTIBLE }
	flaming	 	{ FILE_NAME "bln_danger" INTERRUPTIBLE }



}

