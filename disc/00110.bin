# ****************************************************************************
#	Name    : Sparx.agr
#	Author  : T. Yap
#	Version : 1.0,Jan 25,2001
#	Copyright (C) 2000 Check Six Studios
#
#	These coded instructions, statements and computer programs contain
#	unpublished information proprietary to Check Six Studios and are protected
#	by Canadian and US federal copyright laws. They may not be disclosed to third
#	parties or copied or duplicated, in whole or in part, without prior written
#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	Dragonfly Animation definitions
#
# **********************************************************
#	Format:
#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************

CLIP_LIBRARY    "clips_dragonflies.mrb"

STATE_DEFINITION
{
	land_idle	{ FILE_NAME "df_land_idle" PRECACHE CYCLING INTERRUPTIBLE OVERRIDE }
	land_bored	{ FILE_NAME "df_land_bored"	INTERRUPTIBLE OVERRIDE LOCKED}
	land_recognize	{ FILE_NAME "df_land_recognize"	INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 91
			 	}
			}
	land_move	{ FILE_NAME "df_land_hop"	CYCLING INTERRUPTIBLE OVERRIDE }
	land_taunt	{ FILE_NAME "df_land_taunt"	INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 94
			 	}
			}
	air_idle	{ FILE_NAME "df_fly_hover"	CYCLING INTERRUPTIBLE OVERRIDE }
	air_bored	{ FILE_NAME "df_fly_bored"	INTERRUPTIBLE OVERRIDE LOCKED}
	air_recognize	{ FILE_NAME "df_fly_recognize"	INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 91
			 	}
			}
	air_move	{ FILE_NAME "df_fly_foward"	CYCLING INTERRUPTIBLE OVERRIDE }
	air_taunt	{ FILE_NAME "df_fly_taunt"	INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 94
			 	}
			}
	captured	{ FILE_NAME "df_fly_captured"	OVERRIDE LOCKED
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 95
			 	}
			}
}

# ****************************************************************************
# Connectivity of the states above
# ****************************************************************************



STATE_GRAPH
{

}
# ****************************************************************************
#	Name    : kuala.agr
#	Author  : T. Yap
#	Version : 1.0,Dec 7,2000
#	Copyright (C) 2000 Check Six Studios
#
#	These coded instructions, statements and computer programs contain
#	unpublished information proprietary to Check Six Studios and are protected
#	by Canadian and US federal copyright laws. They may not be disclosed to third
#	parties or copied or duplicated, in whole or in part, without prior written
#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	kuala Animation definitions
#
# **********************************************************
#	Format:
#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************

STATE_DEFINITION
{
	# Movement

	idle        	{ FILE_NAME "bdgn_idle_c" PRECACHE INTERRUPTIBLE CYCLING}
	bored	   	{ FILE_NAME "bdgn_bored_c" INTERRUPTIBLE }
	recognize 	{ FILE_NAME "bdgn_recognize_c" INTERRUPTIBLE }
	walk        	{ FILE_NAME "bdgn_walk_c" INTERRUPTIBLE CYCLING}
	talk         	{ FILE_NAME "bdgn_talk_c" FIXEDSPEED: 1.1 INTERRUPTIBLE CYCLING}
	damaged      	{ FILE_NAME "bdgn_damage_c" INTERRUPTIBLE
				CALLBACK
			 	{
		 		FRAME 0.1 1.0
		 		SOUND 1002
			 	}
			}


}

# ****************************************************************************
# Connectivity of the states above
# ****************************************************************************
STATE_GRAPH
{
}

