#
# **********************************************************
#	Format:
#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************

STATE_DEFINITION
{
	# Movement

	idle        	{ FILE_NAME "i_idle" PRECACHE INTERRUPTIBLE CYCLING}
	walk        	{ FILE_NAME "i_walk" INTERRUPTIBLE CYCLING
				CALLBACK
			 	{
		 		FRAME 0.1 1.0
		 		SOUND 614
			 	}
			}
	startready      { FILE_NAME "i_start_aim" INTERRUPTIBLE }
	ready        	{ FILE_NAME "i_ready" INTERRUPTIBLE CYCLING}
	endready        { FILE_NAME "i_end_aim" INTERRUPTIBLE }
	attack       	{ FILE_NAME "i_attack" INTERRUPTIBLE
				CALLBACK
			 	{
		 		FRAME 0.1 1.0
		 		SOUND 606
			 	}
			}
	victory      	{ FILE_NAME "i_victory" INTERRUPTIBLE }
	die      	{ FILE_NAME "i_die"
				CALLBACK
			 	{
		 		FRAME 0.1 1.0
		 		SOUND 607
			 	}
				
				CALLBACK
			 	{
		 		FRAME 0.8 1.0
		 		SOUND 50
			 	}
			}





}

