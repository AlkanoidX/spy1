# ****************************************************************************
#	Description:
#	Dragonfly Animation definitions
#
# **********************************************************
#	Format:
#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************

STATE_DEFINITION
{
	CoverOpen	{ FILE_NAME "atlas_cover_open" PRECACHE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
	TurnLeft	{ FILE_NAME "atlas_turn_left" PRECACHE	OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
	TurnRight	{ FILE_NAME "atlas_turn_right"	PRECACHE	OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
	FlipLeft	{ FILE_NAME "atlas_flip_left"	PRECACHE	OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
	FlipRight	{ FILE_NAME "atlas_flip_right"	PRECACHE	OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
	CoverClose	{ FILE_NAME "atlas_cover_close"	PRECACHE	OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 8
			 	}
			}
}

