#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************

STATE_DEFINITION
{
	# Movement

	fire        	{ FILE_NAME "TR_Fire4" PRECACHE INTERRUPTIBLE }
	idle	   	{ FILE_NAME "TR_Idle4" INTERRUPTIBLE CYCLING}
	die      	{ FILE_NAME "TR_Die4" }


}

# ****************************************************************************
# Connectivity of the states above
# ****************************************************************************
STATE_GRAPH
{
}

