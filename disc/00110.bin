#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	Dragon Animation definitions
#
# **********************************************************
#	Format:
#	STATE_DEFINITION
#	{
#		FILE_NAME:  Name of clip in Maya trax editor
#
#		One or None of:
#			Name:				Params
#
#			CYCLING				<none>
#			INTERRUPTIBLE		<none>
#			OVERRIDE			<none>
#			OVERLAPPING			<none>
#			OVERLAPPING_AREA	<int>
#			CHANGEDIR			<none>
#
# **********************************************************
#
#

STATE_DEFINITION
{
	# Movement

	spitIdle       { FILE_NAME "spitfire_idle" PRECACHE   CYCLING  INTERRUPTIBLE OVERRIDE }

	spitTurnL      { FILE_NAME "spitfire_bank_L"  CYCLING   INTERRUPTIBLE OVERRIDE}

	spitTurnR      { FILE_NAME "spitfire_bank_R"  CYCLING   INTERRUPTIBLE OVERRIDE}

	spitLoop        { FILE_NAME "spitfire_loop"	   INTERRUPTIBLE OVERRIDE}

	spitDiving  	{ FILE_NAME "spitfire_dive"	 CYCLING  INTERRUPTIBLE OVERRIDE}

	spitClimbing    { FILE_NAME "spitfire_climb"	CYCLING   INTERRUPTIBLE OVERRIDE}

	spitRollLeft	{ FILE_NAME "spitfire_rollout_L" CYCLING   INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 606
			 	}
			}

	spitRollRight   { FILE_NAME "spitfire_rollout_R"  CYCLING   INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 606
			 	}
			}

	spitFireL    { FILE_NAME "spitfire_fire_mg_L"	OVERLAPPING_AREA 1 CYCLING INTERRUPTIBLE OVERRIDE}

	spitFireR    { FILE_NAME "spitfire_fire_mg_R"	OVERLAPPING_AREA 1 CYCLING INTERRUPTIBLE OVERRIDE}

	spitPropeller  { FILE_NAME "spitfire_propeller1" OVERLAPPING_AREA 2  CYCLING   OVERRIDE}

	spitRocketL   { FILE_NAME "spitfire_rocket_fire_L"	 OVERLAPPING_AREA 1 CYCLING  INTERRUPTIBLE OVERRIDE}

	spitRocketR  { FILE_NAME "spitfire_rocket_fire_R"	 OVERLAPPING_AREA 1 CYCLING  INTERRUPTIBLE OVERRIDE}

	spitDamage      { FILE_NAME "spitfire_take_damage"	   INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 603
			 	}
			}

	spitDieA         { FILE_NAME "spitfire_defeated_A4"	   INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 608
			 	}
			}

	spitDieB        { FILE_NAME "spitfire_defeated_B"	  CYCLING INTERRUPTIBLE OVERRIDE
				CALLBACK
			 	{
		 		FRAME 0.1 0.999
		 		SOUND 608
			 	}
			}

}

# ****************************************************************************
# Connectivity of the states above
# ****************************************************************************
STATE_GRAPH
{

