# TYPE

#define 	FLAME				1

# GROUP

#define PRIMARY_WEAPON				0x01

Weapon
{
	Name: 		"fire_breath"
	FileName:	"s_fire.mrb"
	Icon:		"fire_weapon_icons.mrb"
	Type:		1
	Group:		1
	Range:		10
	Streams:   	5
	Active:	   	0 1			#  means always on,  0 0 means starts off,  world flag means check the world flag
	Sound:      	33
	Interval:	0.85
	Poof:       "pooffx.mrb"
	FirePoof:   "fire_poof.mrb"
}

Weapon
{
	Name: 		"ice_breath"
	FileName:	"s_ice.mrb"
	Icon:		"ice_weapon_icons.mrb"
	Type:		2
	Group:		1
	Range:		10
	Streams:   	7
	Active:	   	9 1		# world flag to check
	Sound:      	35
	Interval:	0.85
}

Weapon
{
	Name: 		"lightning_breath"
	FileName:	"s_lightning.mrb"
	Icon:		"lightning_weapon_icons.mrb"
	Type:		3
	Group:		1
	Range:		10
	Streams:   	5
	Active:	   	9 2		# world flag to check
	Sound:      	36
	Interval:	0.85
}

Projectile:   "projweap.edf"

Weapon
{
	Name: 		"bubble_breath"
	FileName:	"bubble_breath.mrb"
	Icon:		"bubble_weapon_icons.mrb"
	Type:		4
	Group:		1
	Range:		10
	Streams:   	3 #5 #0
	Active:	   	9 3    # world flag to check
	Sound:      	34
	Interval:	1.25
}

Weapon
{
	Name: 		"Superfire"
	Group:		2
	Active:     0 0
