ProjectileInfo
	{
	MRB:		"bullet.mrb"
	Name:		"spitBullet"
	SpeedRange:	4500.0	4500.0
	ArcRange:	0.0	0.0
	Gravity:	0.0
	Bounces:	0
	FlightTime:		4.0
	#Shrapnel:	"spitfire_Super_fire_Explosion_shrapnel.edf"
	CollisionRadius: 50.0
	#DUPLICATE_GRAPH
	TRACK_TARGET: 40.0 100.0  0.5 

	Damage:		Underwater_Charge
	#Poof:		"Tank_Explosion.mrb"
	Interval:	0.2
	

#	DON'T make MaxOnScreen a large number.  It exists to help you manage your resources!  Use it that way!
	MaxOnScreen:	30

	Life:      30.0
	LaunchSound:		31
	ExplodeSound:		0
	}


ProjectileInfo
	{
	MRB:		"missile.mrb"
	Name:		"spitMissile"
	SpeedRange:	7000.0	7000.0
	ArcRange:	0.0	0.0
	Gravity:	-1400.0
	Bounces:	0
	FlightTime:		6.0
	Shrapnel:	"spitfire_Super_fire_Explosion_shrapnel.edf"
	CollisionRadius: 100.0
	DUPLICATE_GRAPH
	TRACK_TARGET: 40.0 100.0  0.5 
	ALWAYS_ON

	Damage:		Charge
	Poof:		"Tank_Explosion.mrb"
	Interval:	0.2
	

#	DON'T make MaxOnScreen a large number.  It exists to help you manage your resources!  Use it that way!
	MaxOnScreen:	8

	Life:      30.0
	LaunchSound:		604
	ExplodeSound:		37
	}






												
# ****************************************************************************
#	Name    : SPYRO_VEHICLE.EDF
#	Author  : W. Davis
#	Version : 1.0,June 22,2002
#	Copyright (C) 2000 Check Six Studios
#
#	These coded instructions, statements and computer programs contain
#	unpublished information proprietary to Check Six Studios and are protected 
#	by Canadian and US federal copyright laws. They may not be disclosed to third 
#	parties or copied or duplicated, in whole or in part, without prior written
#	consent of Check Six Studios Inc.
#
#	Unpublished-rights reserved under the Copyright Laws of the United States.
# ****************************************************************************
#	Description:
#	Description of Spyro IN A SPEEDWAY MINIGAME!!!
#	
#		Make sure the appropriate .AGR file and CLIP LIBRARY are specified
#		Make sure all references in Clip Effects are for animations loaded in the .AGR
#		Make sure the weapon rack reflects weapons used for this type of level
#		Make sure the AnimTweak table contains ALL animations regardless of whether or not they are used.
# ****************************************************************************

# The type of character this file defines
Type:					Dragon					

#	MRB File
Geometry_File:			"DRAGON.MRB"

#	Animation State File
#Animation_State_Index:	0
AGRFile: "SPYRO_VEH.AGR"

# Movement parameters in M/s
MaxForward:				10.0			
ForwardAccel:			10.0	
# Turning parameters in Deg/Sec	
MaxTurn:				200.0				


#  new way of doing clip effects.  YOU WILL NEED CODE DATED 2/1/02 or later for this to work!
#  First define Clips as follows.
#
#  ClipEffectDef:  index_(used_later)    "name_of_clip_effect.mrb"   node_to_attach_to   sound
#
#   the indexes don't have to be sequential, but they should be between 0 and 19.  If you need more than
#          20, let me know, and I'll up the maximum.
#   the node to attach to can be  none  or  root  or  a specific node name.  IF AND ONLY IF you use a specific
#   node name you should put it in quotes, and make sure the case is the same as in Maya.

#ClipEffectDef:	0   "super_smash_land.mrb"  NONE  0
ClipEffectDef:	1   "Jump_start_dust.mrb"   ROOT  0
ClipEffectDef:	2   "dust_stop.mrb"   	    ROOT  0
ClipEffectDef:	4   "charge_dust.mrb"       ROOT  0  
#ClipEffectDef:	5   "swimming_bubbles.mrb" "head" 0  
#ClipEffectDef:  6   "ouch_stars.mrb"        ROOT  0
#ClipEffectDef:  7   "smackwall.mrb"         NONE  0
#ClipEffectDef:  8   "smoke_rings.mrb"      "head" 0
ClipEffectDef:  9   "S_Smoke.mrb"          "head" 0 
#ClipEffectDef:  10   "Super_Charge.mrb"          "hip" 0 

#  Once all your clip effects are defined, specify how to use them
#
#   ClipEffect:   "name_of_animation_to_trigger_the_effect"
#					{
#                   index(from_the_definition_above)     delay     surface_indicator
#      ---> you can have more than one line for different surfaces.
#				    }
#
#   surface_indicator can be  GROUND,  WATER,  LAVA,  or  ALL
#


#ClipEffect:    "spyro_supersmash_end"  
#				{
#				0          0.0     ALL
#				}  	

ClipEffect:   "spyro_jump_land" 
				{
				1     0.0      ALL 
				}

ClipEffect:    "spyro_stop_run"  
				{
				2     0.0    ALL
				}

#ClipEffect:   "spyro_damage" 
#			 	{
#				6 	0.0  ALL
#				}

#ClipEffect:    "spyro_smackwall"   	
#				{
#				6   	0.0  ALL
#				}


#ClipEffect:   "spyro_jump_start" 
#ClipEffect:    "spyro_charge"   	"dust_stop.mrb"   	0.0  "root"  0
#ClipEffect:   "spyro_defeated"   	"ouch_stars.mrb"   	0.1   "none"  0
#ClipEffect:    "spyro_swim"	   	"water_splash.mrb"   	0.0   "none"  0
				


ClipEffectAGR:  101
				{
				4     0.0   ALL
				}
							
#ClipEffectAGR:   104 		{ 	
#				5    0.0   ALL
#				}
#
#ClipEffectAGR:   105   		{ 	
#				5  0.2  ALL
#				}
#
#ClipEffectAGR:	 106	 	{ 	
#				5  0.0  ALL
#				}

#ClipEffectAGR:  100  		{
#				7  0.0  ALL
#				}

#ClipEffectAGR:   103		{
#			 	8   	0.3  ALL
#			 	} 

ClipEffectAGR:   102   		{
				9   	0.2  ALL
				}

#ClipEffectAGR:   107   		{
#				10   	0.2  ALL
#				}


# Animation tweaks...  "AnimTweak:   clipName  animSpeed"
# currently must match the order of the clips in the .agr file (clipName is for reference only)
# THIS SHOULD ALWAYS CONTAIN EVERY SPYRO ANIMATION WHETHER IT IS LOADED OR NOT!
AnimTweak:	moveIdle    1.0 
AnimTweak:	moveWalk    1.6 
AnimTweak:	moveRun     1.0 
AnimTweak:	moveCharge  1.3 
AnimTweak:	stopRun     1.0 
AnimTweak:	jumpStart   1.2 
AnimTweak:	jumpCycle   0.5 
AnimTweak:	jumpLand    2.5
AnimTweak:	glideCycle  0.6 
AnimTweak:	glideLand   3.0 
AnimTweak:	turnInIdle  1.0 
AnimTweak:	fallCycle   1.0 
AnimTweak:	fallLand    1.0 
AnimTweak:  smackWall   1.0 
AnimTweak:  smashStart  0.8 
AnimTweak:  smashCycle  1.0 
AnimTweak:  smashEnd    0.8 
AnimTweak:  aerialJump  1.0 
AnimTweak:  aerialStep  1.2 
AnimTweak:  damage      1.3
AnimTweak:  swimIdle    1.0 
AnimTweak:  swim        1.0 
AnimTweak:  flyCycle    1.0 
AnimTweak:  flyDown     1.0 
AnimTweak:  flyUp       1.0 
AnimTweak:  InSwirl     1.0 
AnimTweak:  glidePull   1.0 
AnimTweak:  hoverCycle  2.0 
AnimTweak:  hoverEnd    1.0 
AnimTweak:  stopTurn    1.4   
AnimTweak:  Skate       1.5 
AnimTweak:  uwIdle      1.0 
AnimTweak:  uwSwim      1.0 
AnimTweak:  uwCharge    1.0 
AnimTweak:  climbIdle	1.0
AnimTweak:  climbRt		1.0
AnimTweak:  climbLft	1.0
AnimTweak:  climbUp		1.0
AnimTweak:  climbDown	1.0
AnimTweak:  climbAttach	1.0
AnimTweak:  climbOff	1.0
AnimTweak:  SpitIdle    1.0
AnimTweak:  Spit		1.0
AnimTweak:  Swallow     0.7
AnimTweak:  boredScr	1.0
AnimTweak:  boredSmk	1.0
AnimTweak:	ledgeIdle	1.0
AnimTweak:  ledgeBored  1.0
AnimTweak:  push		1.0
AnimTweak:  groundDie	1.0
AnimTweak:  airDamage	1.0
AnimTweak:  uwDamage	1.0
AnimTweak:  uwDie		1.0
AnimTweak:  wngShOn		1.0
AnimTweak:	wngShOff	1.0
AnimTweak:  wngShCyc	1.0
AnimTweak:  slide       1.0
AnimTweak:  gameOver    1.0
AnimTweak:	damageBurn	1.0
AnimTweak:	damageFlat	1.0
AnimTweak:	damageSpin	1.0
AnimTweak:	dieBurnt	1.0
AnimTweak:	dieFlat		1.0
AnimTweak:	speedUp		1.0
AnimTweak:	slapWater	1.0
AnimTweak:	drum1		1.0
AnimTweak:	drum2		1.0
AnimTweak:	drum3		1.0
AnimTweak:	drum4		1.0
AnimTweak:	drum5		1.0
AnimTweak:	drum6		1.0
AnimTweak:	drum7		1.0
AnimTweak:  fireBreathI  1.5
AnimTweak:  fireBreath   1.5





#Poof Off Effect File
#Poof_Off_Effect:		"fire_poof.mrb"
#Poof_off_Effect_Clip:		0
                      
# Weapon information
#WeaponRack
#{
#	Weapon:					"fire_breath"
#	Weapon:            "ice_breath"
#	Weapon:            "lightning_breath"
#	Weapon:            "bubble_breath"
#	Weapon:            "Superfire"
#}
#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected
#Shadow_Name:		"Shadow_s.mrb"

#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"Super_fire_Explosion_shrapnel.mrb"
	Origin_Offset:		0.0	10.0	0.0
	NumRange:		10	15
	SpeedRange:		900	1800
	VertRange:		30	60
	LifeRange:		2	3
	Bounce:			0.7
	Rotate_Axis_X:		30	60			
	Rotate_Axis_Y:		30	60			
	Rotate_Axis_Z:		30	60			
	Gravity:		1000.0
	Direction:		0.0
#	Poof:			"BURNSMOKE.mrb"
}

#	STATE DEFINITIONS
#	These define the state of the shrapnel
#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	}
	{ DEFSTATE_IDLE		}
	{ DEFSTATE_BOUNCE	}
	{ DEFSTATE_ONDIE	}
}
