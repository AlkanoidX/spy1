{
	ShrapnelGraph:		"turret_sharpnel_A.mrb"
	Origin_Offset:		0.0	800.0	0.0
	NumRange:		1	1
	SpeedRange:		1000	6000
	VertRange:		10	25
	LifeRange:		1	2	
	Bounce:			1.0
	Rotate_Axis_X:		10	540	
	Rotate_Axis_Y:		10	540	
	Rotate_Axis_Z:		10	540			
	Gravity:		900.0
	Direction:		1.0
	Poof:			"POOFFX.mrb"
	UseRadiusCollision:	1
	ImpactMomentum:		1.0
}


IndvShrapDef
{
	ShrapnelGraph:		"turret_sharpnel_B.mrb"
	Origin_Offset:		0.0	600.0	0.0
	NumRange:		4	4
	SpeedRange:		1000	6000
	VertRange:		10	25
	LifeRange:		1	2	
	Bounce:			1.0
