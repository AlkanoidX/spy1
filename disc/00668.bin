ProjectileInfo
	{
	MRB:		"SCR_PROJECTILE.MRB"
	Name:		"THROWN_ROCK_PROJECTILE"
	Damage:		Underwater_Charge
	Poof:		"POOF_OFF_FX_WHITE.mrb"
	Shrapnel:       "SMALL_CAVE_MAN_RIPTOC_PROJECTILE_SHRAPNEL.edf"
	
	SpeedRange:	1800.0	1800.0
	ArcRange:	0.0	0.0
	Gravity:	0.0
	
#	DON'T make MaxOnScreen a large number.  It exists to help you manage your resources!  Use it that way!
	MaxOnScreen:	5
	
	DUPLICATE_GRAPH				# use this if projectile has animation or particles
	FlightTime:      7.0
	LaunchSound:		5
	
	AIM_AT_PLAYER

	}

SoundFX
{
	OnDie: 546
}

ProjectileInfo
	{
	MRB:		"SCR_PROJECTILE.MRB"
	Name:		"KICKED_ROCK_PROJECTILE"
	Damage:		Underwater_Charge
	Poof:		"POOF_OFF_FX_WHITE.mrb"
	Shrapnel:       "SMALL_CAVE_MAN_RIPTOC_PROJECTILE_SHRAPNEL.edf"
	
	SpeedRange:	1300.0	1300.0
	ArcRange:	10.0	10.0
	Gravity:	-150.0
	
#	DON'T make MaxOnScreen a large number.  It exists to help you manage your resources!  Use it that way!
	MaxOnScreen:	5
	
	DUPLICATE_GRAPH				# use this if projectile has animation or particles
	FlightTime:      6.0
	LaunchSound:		609
	
	AIM_AT_PLAYER

	}

SoundFX
{
	OnDie: 546
}

#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected
Shadow_Name:		"Shadow_s.mrb"

#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"scr_spnl_A.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		900	900
	VertRange:		30	70
	LifeRange:		2	3
	Bounce:			0.75
	Rotate_Axis_X:		10	540	
	Rotate_Axis_Y:		10	540	
	Rotate_Axis_Z:		10	540	
	Gravity:		600.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
	UseRadiusCollision:	1
}

IndvShrapDef
{
	ShrapnelGraph:		"scr_spnl_B.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		900	900
	VertRange:		30	80
	LifeRange:		2	3
	Bounce:			0.65
	Rotate_Axis_X:		10	540			
	Rotate_Axis_Y:		10	540			
	Rotate_Axis_Z:		10	540			
	Gravity:		600.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
	UseRadiusCollision:	1
}

IndvShrapDef
{
	ShrapnelGraph:		"scr_spnl_C.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		2	2
	SpeedRange:		900	900
	VertRange:		30	85
	LifeRange:		2	3
	Bounce:			0.7
	Rotate_Axis_X:		10	540			
	Rotate_Axis_Y:		10	540			
	Rotate_Axis_Z:		10	540			
	Gravity:		500.0
	Direction:		0.0
	Poof:			"PoofFx.mrb"
	UseRadiusCollision:	1
}


