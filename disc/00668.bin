#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	    }
	{ DEFSTATE_IDLE			}
	{ DEFSTATE_BOUNCE		}
	{ DEFSTATE_ONDIE		}
}
