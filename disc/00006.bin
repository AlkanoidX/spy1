{
	Startup_State	STATE_OFF
	Never_Prune
	
	Move_Control
	{
		Movement_Type	Air
		Horiz_Limit	0
		Vert_Limit	0
		Yaw_Limit	0
		Pitch_Limit	0
	}

	AI_State_Control
	{
		State_Name		STATE_OFF
		State_Anim 		"magic_off"
		
		Conditions_Control
		{
			Time_limit		0      
			Health			1	1
			Num_times		0	0
			Horiz_Range		0	0
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
		}

		Movement_Control
		{
			Turn_Rate		700
			Acceleration		0
			Deceleration		0
			Max_Speed		0
			
		}

		State_Control
		{	
			
			State_Flow		0	STATE_ON
			
		}
	}

	AI_State_Control
	{
		State_Name		STATE_ON
		State_Anim 		"magic_on"

		
		Conditions_Control
		{
			Time_limit		0      
			Health			1	1
			Num_times		0	0
			Horiz_Range		0	0
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
			WorldFlag_On		9 233
		}

		Movement_Control
		{
			Turn_Rate		700
			Acceleration		0
			Deceleration		0
			Max_Speed		0
			
		}
	
		Flag_Control
		{
			Flag_Index	9 233
			WorldFlag_off
		}
		
		Vulnerabilities_Control
		{
			
			
		}

		State_Control
		{	
			State_Flow		1	STATE_OFF
		}
	}

	
}

#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected


#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"SHRAPNEL_HELPER.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		1	1
	SpeedRange:		400	600
	VertRange:		1	1
	LifeRange:		1	1
	Bounce:			1.0
	Rotate_Axis_X:		30	60			
	Rotate_Axis_Y:		30	60			
	Rotate_Axis_Z:		30	60			
	Gravity:		1000.0
	Direction:		0.0
	
}



#	STATE DEFINITIONS
#	These define the state of the shrapnel
#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	    }
	{ DEFSTATE_IDLE			}
	{ DEFSTATE_BOUNCE		}
	{ DEFSTATE_ONDIE		}
}
