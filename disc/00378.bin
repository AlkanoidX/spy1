# ****************************************************************************



ProjectileInfo
	{
	MRB:		"Super_Fire_Breath.mrb"
	Name:		"Superfire"
	SpeedRange:	1600.0	1600.0
	ArcRange:	0.0	0.0
	Gravity:	0.0
	Bounces:	0
	FlightTime:		6.0
	Poof:		"Super_Fire_Explosion.mrb"
	Shrapnel:   "Super_fire_Explosion_shrapnel.edf"	

	Damage:		Super_Flame
	Interval:	0.5
	CollisionRadius:	100.0		# this is in centimeters

#	DON'T make MaxOnScreen a large number.  It exists to help you manage your resources!  Use it that way!
	MaxOnScreen:	5
	
	DUPLICATE_GRAPH				# use this if projectile has animation or particles

	Life:      30.0
	LaunchSound:		33
	ExplodeSound:		37
	}



#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected


#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"SHRAPNEL_HELPER.mrb"
	Origin_Offset:		0.0	0.0	0.0
	NumRange:		1	1
	SpeedRange:		400	600
	VertRange:		1	1
	LifeRange:		1	1
	Bounce:			1.0
	Rotate_Axis_X:		30	60			
	Rotate_Axis_Y:		30	60			
	Rotate_Axis_Z:		30	60			
	Gravity:		1000.0
	Direction:		0.0
	
}



#	STATE DEFINITIONS
#	These define the state of the shrapnel
#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	    }
	{ DEFSTATE_IDLE			}
	{ DEFSTATE_BOUNCE		}
	{ DEFSTATE_ONDIE		}
}
