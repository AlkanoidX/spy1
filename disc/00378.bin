#	TYPE
#	 
Type:		Shrapnel




#	SHADOW
#	Shadow_Type can be either CAST or PROJECTED
#	Shadow_Name is the mesh for a Projected Shadow
#
#Shadow_Type:		projected
#Shadow_Name:		"Shadow_s.mrb"

#	SHRAPNEL
#	Shrapdef allows different parameters for different pieces
#	Shrapnel is the name of the shrapnel geometry in the file
#	Numrange is the number of shrapnel released
#	SpeedRange is in cm/s
#	VertRange is in degrees
#	LifeRange is in seconds
#	Bounce is a multiplier
#	Rotate Axis is in degrees per second
#	Gravity is a multiplier
#	Poof is the name of the poof mrb to be used
#	

IndvShrapDef
{
	ShrapnelGraph:		"Super_fire_Explosion_shrapnel.mrb"
	Origin_Offset:		0.0	10.0	0.0
	NumRange:		10	15
	SpeedRange:		900	1800
	VertRange:		30	60
	LifeRange:		2	3
	Bounce:			0.7
	Rotate_Axis_X:		30	60			
	Rotate_Axis_Y:		30	60			
	Rotate_Axis_Z:		30	60			
	Gravity:		1000.0
	Direction:		0.0
#	Poof:			"BURNSMOKE.mrb"
}

#	STATE DEFINITIONS
#	These define the state of the shrapnel
#	Currently only used for sound assignments
State_Definition
{
	{ DEFSTATE_ONCREATE	}
	{ DEFSTATE_IDLE		}
	{ DEFSTATE_BOUNCE	}
	{ DEFSTATE_ONDIE	}
}
