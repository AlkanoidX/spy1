Geometry_File:			"BIANCA.MRB"
AGRFile:				"BIANCA.AGR"
#Shadow_Name: 			"Shadow_L.mrb"

Collision
{
	Primitive: Cylinder
	ID: 0
}

AI_Definition_Control
{
	Startup_State	STATE_IDLE

	Move_Control
	{
		Movement_Type	Air
		Horiz_Limit		0
		Vert_Limit		0
		Yaw_Limit		0
		Pitch_Limit		0
	}

	AI_State_Control
	{
		State_Name		STATE_IDLE
		State_Anim		"stay_small"
		
		#Assert	{string "idle\n"}
#		INVISIBLE

		Conditions_Control
		{
			Time_limit		0
			Health			1	1
			Num_times		0	0
			Horiz_Range		0	0
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
		}

		Movement_Control
		{
			Turn_Rate		0
			Acceleration	0
			Deceleration	0
			Max_Speed		0
		}

		
		State_Control
		{
			State_Flow		0	STATE_HIDE
			State_Flow		0	STATE_GRAB
		}
	}

	AI_State_Control
	{
		State_Name		STATE_GRAB
		State_Anim		"stay_small"

		#Assert	{string "grab\n"}

		Conditions_Control
		{
			Time_limit		0
			Health			1	1
			Num_times		0	0
			Horiz_Range		0	2000
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
			WorldFlag_On	4	0
			WorldFlag_On	4	1
			WorldFlag_On	4	2
			WorldFlag_Count	3
		}

		Movement_Control
		{
			Turn_Rate		0
			Acceleration	0
			Deceleration	0
			Max_Speed		0
		}

		Conversation_Control
		{
			Script			"TurnOnTheLaser1.scr"
			WaitAnim
			MustRun
		}

		State_Control
		{
			#State_Flow		1	STATE_FLY_TO_HOURGLASS
			State_Flow		1	STATE_HIDE
		}
	}

	AI_State_Control
	{
		State_Name		STATE_FLY_TO_HOURGLASS
		State_Anim		"stay_small"


		FORCE_CAMERA_LOOK

		Conditions_Control
		{
			Time_limit		0
			Health			0		1
			Num_times		0		0
			Horiz_Range		0		0
			Vert_Range		0		0
			Pitch_Range		0		0
			Yaw_Range		0		0
		}

		Movement_Control
		{
			Turn_Rate		500
			Acceleration	4000
			Deceleration	500
			Max_Speed		8000
			Secondary_Spline		"curveShape1"
			Run_On_Spline_From		One_Way
		}

		Vulnerabilities_Control
		{

		}

		State_Control
		{
			State_Flow		1	STATE_WAIT_WHILE_SHOOTING_LOAD
		}
	}

	AI_State_Control
	{
		State_Name		STATE_WAIT_WHILE_SHOOTING_LOAD
		State_Anim		"stay_small"

		FORCE_CAMERA_LOOK

		#Assert	{string "hide\n"}

	

		Conditions_Control
		{
			Time_limit		0
			Health			0	1
			Num_times		0	0
			Horiz_Range		0	0
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
		}

		Movement_Control
		{
			Turn_Rate		0
			Acceleration	0
			Deceleration	0
			Max_Speed		0
		}

		Flag_Control
		{
			#FIRE THE "LASER"!!
			Flag_Index	4 32
			WorldFlag_On
		}
		
		State_Control
		{
			State_Flow		1	STATE_HIDE
		}
	}

	AI_State_Control
	{
		State_Name		STATE_HIDE
		State_Anim		"stay_small"

		#Assert	{string "hide\n"}

		INVISIBLE

		Conditions_Control
		{
			Time_limit		4
			Health			0	1
			Num_times		0	0
			Horiz_Range		0	0
			Vert_Range		0	0
			Pitch_Range		0	0
			Yaw_Range		0	0
			WorldFlag_On	4	32
		}

		Movement_Control
		{
			Turn_Rate		0
			Acceleration	0
			Deceleration	0
			Max_Speed		0
		}

		
		State_Control
		{
			State_Flow		1	STATE_HIDE
		}
	}
}
